{
  "entity": {
    "binary_sensor": {
      "goal_reached_today": {
        "default": "mdi:trophy-outline",
        "state": {
          "on": "mdi:trophy"
        }
      },
      "all_reached_today": {
        "default": "mdi:account-group-outline",
        "state": {
          "on": "mdi:account-group"
        }
      }
    },
    "button": {
      "add": {
        "default": "mdi:plus"
      },
      "subtract": {
        "default": "mdi:minus"
      }
    },
    "event": {
      "milestone": {
        "default": "mdi:party-popper",
        "state_attributes": {
          "event_type": {
            "state": {
              "streak": "mdi:fire",
              "best_streak": "mdi:medal",
              "best_day": "mdi:star",
              "total": "mdi:sigma"
            }
          }
        }
      },
      "group": {
        "default": "mdi:podium",
        "state_attributes": {
          "event_type": {
            "state": {
              "lead_change": "mdi:podium-gold",
              "week_winner": "mdi:trophy-award",
              "goal_reached": "mdi:flag-checkered"
            }
          }
        }
      }
    },
    "number": {
      "today": {
        "default": "mdi:counter"
      }
    },
    "sensor": {
      "today_target": {
        "default": "mdi:bullseye-arrow"
      },
      "progress": {
        "default": "mdi:progress-check"
      },
      "total": {
        "default": "mdi:sigma"
      },
      "current_streak": {
        "default": "mdi:fire"
      },
      "best_streak": {
        "default": "mdi:medal"
      },
      "target_to_date": {
        "default": "mdi:calendar-check"
      },
      "delta": {
        "default": "mdi:plus-minus-variant"
      },
      "remaining": {
        "default": "mdi:flag-checkered"
      },
      "days_left": {
        "default": "mdi:calendar-clock"
      },
      "required_per_day": {
        "default": "mdi:speedometer"
      },
      "average": {
        "default": "mdi:chart-line"
      },
      "best_day": {
        "default": "mdi:star"
      },
      "this_week": {
        "default": "mdi:calendar-week"
      },
      "this_month": {
        "default": "mdi:calendar-month"
      },
      "this_year": {
        "default": "mdi:calendar"
      },
      "leader": {
        "default": "mdi:podium-gold"
      },
      "group_streak": {
        "default": "mdi:fire"
      },
      "last_week_winner": {
        "default": "mdi:trophy-award"
      },
      "group_total": {
        "default": "mdi:sigma"
      },
      "group_goal_progress": {
        "default": "mdi:progress-check"
      },
      "group_goal_remaining": {
        "default": "mdi:flag-checkered"
      }
    }
  },
  "services": {
    "add": {
      "service": "mdi:plus-circle"
    },
    "set": {
      "service": "mdi:pencil"
    },
    "get_history": {
      "service": "mdi:history"
    },
    "get_status": {
      "service": "mdi:information-outline"
    }
  }
}
